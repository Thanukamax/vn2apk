{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vn2apk",
  "version": "1.0.0",
  "identifier": "com.vn2apk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "vn2apk",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "dmg": {}
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
